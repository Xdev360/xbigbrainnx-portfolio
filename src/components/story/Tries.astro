---
// "What I tried": each attempt in three beats. Why I tried it, what happened, and what I did next.
// The text column is exactly as tall as the phone beside it. "What I did" is the part that matters, so it leads visually.
import Icon from '../Icon.astro';
interface Props { items: { t: string; why: string; then: string; did?: string; src?: string }[] }
const { items } = Astro.props;
---
<ol class="tries" data-tries>
  <span class="rail" aria-hidden="true"><span></span></span>
  {items.map((it, i) => (
    <li class="try" data-reveal>
      <span class="mark" aria-hidden="true"></span>
      <div class="txt">
        <div class="head"><span class="label c-accent">Try {String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</span><h4 class="h3 c-heading">{it.t}</h4></div>
        <div class="beats">
          <div class="beat"><span class="eyebrow c-subtle">Why I tried it</span><p class="small c-secondary">{it.why}</p></div>
          <div class="beat"><span class="eyebrow c-subtle">What happened</span><p class="small c-secondary">{it.then}</p></div>
        </div>
        {it.did && (
          <div class="did">
            <span class="eyebrow c-primary"><Icon name="corner-down-right" size={12} /> What I did</span>
            <p class="body c-primary">{it.did}</p>
          </div>
        )}
      </div>
      {it.src && <div class="shot-w"><img class="shot" src={it.src} alt={it.t} loading="lazy" /></div>}
    </li>
  ))}
</ol>
<style>
  .tries { position:relative; display:flex; flex-direction:column; gap:72px; padding-left:36px; }
  .rail { position:absolute; left:5px; top:6px; bottom:6px; width:1px; background:var(--border-default); }
  .rail span { position:absolute; inset:0; background:linear-gradient(#F30058, #FFA41C, #19F2FF, #3084FF); transform-origin:top; transform:scaleY(var(--p,0)); }
  .try { position:relative; display:grid; grid-template-columns:minmax(0,1fr) 220px; column-gap:40px; align-items:stretch; max-width:760px; }
  .mark { position:absolute; left:-36px; top:2px; width:11px; height:11px; transform:rotate(45deg); background:var(--bg-page); border:1px solid var(--border-strong); transition:background var(--dur-3), border-color var(--dur-3); }
  .try.lit .mark { background:var(--accent-label); border-color:var(--accent-label); }

  /* Text column: stretched to the phone's height, beats spread top to bottom */
  .txt { display:flex; flex-direction:column; justify-content:space-between; gap:20px; min-height:100%; }
  .head { display:flex; flex-direction:column; gap:8px; }
  .beats { display:flex; flex-direction:column; gap:16px; }
  .beat { display:flex; flex-direction:column; gap:6px; padding-top:12px; border-top:1px solid var(--border-default); }
  .did { display:flex; flex-direction:column; gap:10px; padding:18px 20px; border:1px solid var(--border-strong); background:var(--bg-alt); position:relative; overflow:hidden; }
  .did::before { content:''; position:absolute; left:0; top:0; bottom:0; width:2px; background:var(--accent-label); transform:scaleY(0); transform-origin:top; transition:transform 700ms var(--ease-dec) 200ms; }
  .try.lit .did::before { transform:none; }
  .did .eyebrow { display:inline-flex; align-items:center; gap:6px; }

  .shot-w { align-self:start; }
  .shot { display:block; width:220px; border-radius:24px; border:1px solid var(--border-strong); transform:rotate(var(--r,2deg)) translateY(12px); opacity:0; transition:transform 700ms var(--ease-dec), opacity 500ms; }
  .try:nth-child(odd) .shot { --r:-2deg; }
  .try.lit .shot { opacity:1; transform:rotate(var(--r,2deg)); }
  .shot:hover { transform:rotate(0) scale(1.03); }

  @media (max-width:767px){
    .tries { gap:56px; padding-left:28px; }
    .mark { left:-28px; }
    .try { grid-template-columns:1fr; row-gap:24px; }
    .shot { width:180px; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tries]').forEach(root => {
    const rail = root.querySelector<HTMLElement>('.rail span')!, items = [...root.querySelectorAll<HTMLElement>('.try')];
    const on = () => {
      const r = root.getBoundingClientRect(), mid = innerHeight * .55;
      rail.style.setProperty('--p', String(Math.min(1, Math.max(0, (mid - r.top) / r.height))));
      items.forEach(it => it.classList.toggle('lit', it.getBoundingClientRect().top < mid));
    };
    addEventListener('scroll', on, { passive: true }); on();
  });
</script>
