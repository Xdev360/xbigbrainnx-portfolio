---
// Scroll zoom. One screen sits still while the camera moves to each focus point and the note changes.
interface Props { label: string; src?: string; stops: { x: number; y: number; scale: number; title: string; text: string }[] }
const { label, src, stops } = Astro.props;
---
<div class="zoom" data-zoom data-stops={JSON.stringify(stops)} style={`--n:${stops.length}`}>
  <div class="stick">
    <div class="frame">
      <div class="cam">
        {src ? <img src={src} alt={label} /> : <div class="ph"><span class="mono-tag c-subtle">{label}</span><span class="meta c-subtle">Full screen from Figma</span>
          {stops.slice(1).map(s => <span class="spot" style={`left:${s.x}%;top:${s.y}%`}><span class="mono-tag">{s.title}</span></span>)}</div>}
      </div>
      <div class="vign" aria-hidden="true"></div>
    </div>
    <div class="notes">
      <div class="dots">{stops.map(() => <span></span>)}</div>
      {stops.map((s, i) => <div class="note" data-i={i}><span class="eyebrow c-primary">{s.title}</span><p class="small c-muted">{s.text}</p></div>)}
    </div>
  </div>
</div>
<style>
  .zoom { height:calc(var(--n) * 80vh); position:relative; }
  .stick { position:sticky; top:96px; display:flex; flex-direction:column; gap:20px; }
  .frame { position:relative; aspect-ratio:16/9; max-height:64vh; overflow:hidden; border:1px solid var(--border-default); background:var(--bg-alt); }
  .cam { position:absolute; inset:0; transform-origin:var(--ox,50%) var(--oy,50%); transform:scale(var(--s,1)); transition:transform 1100ms var(--ease-dec), transform-origin 1100ms var(--ease-dec); }
  .cam img { width:100%; height:100%; object-fit:contain; }
  @media (max-width:767px){ .spot { display:none; } .ph .mono-tag { font-size:10px; } }
  .ph { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; }
  .spot { position:absolute; translate:-50% -50%; padding:4px 6px; border:1px dashed var(--border-strong); background:var(--bg-page); }
  .spot .mono-tag { font-size:6px; line-height:8px; color:var(--text-muted); }
  .vign { position:absolute; inset:0; pointer-events:none; box-shadow:inset 0 0 0 1px var(--border-default); }
  .notes { position:relative; min-height:80px; display:flex; gap:24px; align-items:flex-start; }
  .dots { display:flex; flex-direction:column; gap:6px; padding-top:4px; }
  .dots span { width:6px; height:6px; border:1px solid var(--border-strong); transition:background var(--dur-3), border-color var(--dur-3); }
  .dots span.on { background:var(--text-primary); border-color:var(--text-primary); }
  .note { position:absolute; left:30px; right:0; top:0; display:flex; flex-direction:column; gap:6px; opacity:0; transform:translateY(10px); transition:opacity var(--dur-3), transform var(--dur-3) var(--ease-dec); }
  .note.on { opacity:1; transform:none; }
</style>
<script>
  import { play } from '../../lib/sensory';
  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach(root => {
    const stops = JSON.parse(root.dataset.stops!) as { x: number; y: number; scale: number }[];
    const cam = root.querySelector<HTMLElement>('.cam')!;
    const notes = [...root.querySelectorAll<HTMLElement>('.note')], dots = [...root.querySelectorAll<HTMLElement>('.dots span')];
    let cur = -1;
    const set = (i: number) => {
      if (i === cur) return; cur = i; const s = stops[i];
      cam.style.setProperty('--ox', `${s.x}%`); cam.style.setProperty('--oy', `${s.y}%`); cam.style.setProperty('--s', String(s.scale));
      notes.forEach((n, k) => n.classList.toggle('on', k === i)); dots.forEach((d, k) => d.classList.toggle('on', k === i));
      if (i > 0) play('tick');
    };
    const on = () => { const r = root.getBoundingClientRect(); const p = Math.min(.999, Math.max(0, -(r.top - 96) / (r.height - innerHeight * .8))); set(Math.floor(p * stops.length)); };
    addEventListener('scroll', on, { passive: true }); on();
  });
</script>
