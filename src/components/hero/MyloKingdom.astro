---
// Mylo Kingdom: the hero scene for Mylo. Flat vector illustration from the MYLO Figma file
// (page "Mylo · Kingdom (hero)"), animated in CSS/JS. No raster background, no Rive watermark.
// Stage is 1440 x 900 in hero coordinates (y counts from under the nav, like the reel).
// Everything that moves stays inside x 160-1280, y 80-440, clear of the headline and Now Playing.
import kingdom from '../../assets/mylo-kingdom.svg?raw';
const K = '/work/mylo/kit/';
const phones = [
  { src: '/work/mylo/new-today.webp', label: 'Today', cx: 445, cy: 228, h: 236, r: -8, d: 0 },
  { src: '/work/mylo/levels.webp', label: 'Your level', cx: 570, cy: 220, h: 262, r: 0, d: 1.4 },
  { src: '/work/mylo/room-chat.webp', label: 'Room chat', cx: 695, cy: 228, h: 236, r: 8, d: 2.6 },
];
---
<div class="mk" data-mk>
  <div class="mk-bg" set:html={kingdom}></div>

  <div class="mk-stage" data-stage>
    <div class="phones" data-depth="14">
      {phones.map(p => {
        const w = Math.round(p.h * 393 / 852);
        return (
          <figure class="ph" style={`left:${p.cx - w / 2}px;top:${p.cy - p.h / 2}px;width:${w}px;height:${p.h}px;--r:${p.r}deg;--d:${p.d}s`}>
            <img src={p.src} alt={`Mylo · ${p.label}`} loading="lazy" decoding="async" />
          </figure>
        );
      })}
    </div>

    <div class="isl" data-depth="18">
      <svg class="isl-art" viewBox="1040 318 240 122" width="240" height="122" aria-hidden="true">
        <path d="M1050 340H1270C1248 372.2 1195.2 386.3 1164.4 435.6C1138 393.4 1076.4 379.3 1050 340Z" fill="#5B4A8F"/>
        <path d="M1171 340H1270C1248 372.2 1195.2 386.3 1164.4 435.6L1171 340Z" fill="#46397A"/>
        <ellipse cx="1160" cy="343" rx="114" ry="11" fill="#4E9E7E"/>
        <ellipse cx="1160" cy="335" rx="114" ry="11" fill="#7FD3AE"/>
        <circle cx="1080.4" cy="330" r="4" fill="#FF9EC4"/>
        <circle cx="1234.4" cy="332" r="4" fill="#FFD27A"/>
      </svg>
      <div class="mylo">
        <div class="m-move" data-move>
          <span class="shadow"></span>
          <div class="m-flip" data-flip>
            <div class="m-body" data-body>
              <img class="ly hat" data-l="hat" src={`${K}hat-beanie.webp`} alt="" />
              <img class="ly outfit" data-l="outfit" src={`${K}outfit-sweater.webp`} alt="" />
              <img class="ly face" data-l="face" src={`${K}face-love.webp`} alt="" />
              <img class="ly body" src={`${K}body-white.webp`} alt="Mylo" />
            </div>
          </div>
        </div>
        <div class="spark" data-spark>{[0, 1, 2, 3, 4, 5].map(i => <i style={`--a:${i * 60}deg`}></i>)}</div>
      </div>
    </div>

    <span class="gem" data-gem></span>
  </div>
</div>

<style>
  .mk { position:absolute; inset:0; overflow:hidden; background:#241F5C; }
  .mk-bg { position:absolute; inset:0; }
  .mk-bg :global(svg.kd) { position:absolute; left:0; top:0; width:100%; height:100%; display:block; }

  /* --- Scenery motion (all inside the safe area) --- */
  .mk-bg :global(#stars .tw) { animation:tw 3.8s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  .mk-bg :global(#stars .tw:nth-child(3n)) { animation-delay:-1.2s; animation-duration:4.6s; }
  .mk-bg :global(#stars .tw:nth-child(3n+1)) { animation-delay:-2.4s; animation-duration:3.2s; }
  .mk-bg :global(#stars .sp) { animation:sp 2.8s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  .mk-bg :global(#stars .sp:nth-of-type(2n)) { animation-delay:-1.4s; }
  @keyframes tw { 0%,100% { opacity:.35; } 50% { opacity:1; transform:scale(1.6); } }
  @keyframes sp { 0%,100% { transform:scale(.7) rotate(0); opacity:.6; } 50% { transform:scale(1.15) rotate(45deg); opacity:1; } }

  .mk-bg :global(#moon .halo) { animation:halo 5s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  @keyframes halo { 50% { transform:scale(1.18); opacity:.6; } }

  .mk-bg :global(#clouds .cl) { animation:drift 22s ease-in-out infinite alternate; }
  .mk-bg :global(#clouds .c2) { animation-duration:28s; animation-delay:-6s; }
  .mk-bg :global(#clouds .c3) { animation-duration:18s; animation-delay:-3s; }
  .mk-bg :global(#clouds .c4) { animation-duration:25s; animation-delay:-9s; }
  .mk-bg :global(#clouds .c5) { animation-duration:20s; animation-delay:-12s; }
  @keyframes drift { from { transform:translateX(-22px); } to { transform:translateX(22px); } }

  .mk-bg :global(#castle .flag) { animation:flag 1.6s ease-in-out infinite; transform-box:fill-box; transform-origin:0 50%; }
  @keyframes flag { 50% { transform:scaleX(.78) skewY(6deg); } }
  .mk-bg :global(#castle .win rect), .mk-bg :global(#mid-hills .lit) { animation:win 6s steps(1) infinite; }
  .mk-bg :global(#castle .win rect:nth-child(2n)) { animation-delay:-2.5s; }
  @keyframes win { 0%,100% { opacity:1; } 46% { opacity:.55; } 48% { opacity:1; } }

  .mk-bg :global(#mid-hills .tree) { animation:sway 5s ease-in-out infinite; transform-box:fill-box; transform-origin:50% 100%; }
  .mk-bg :global(#mid-hills .tree:nth-of-type(2n)) { animation-delay:-2s; }
  @keyframes sway { 50% { transform:rotate(2.2deg); } }
  .mk-bg :global(#mid-hills .lantern .halo) { animation:halo 2.6s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  .mk-bg :global(#mid-hills .lantern:nth-of-type(2n) .halo) { animation-delay:-1.3s; }

  .mk-bg :global(.float) { animation:fl 7s ease-in-out infinite; }
  .mk-bg :global(#foreground .ff) { animation:ff 6s ease-in-out infinite; }
  .mk-bg :global(#foreground .ff:nth-of-type(2n)) { animation-duration:8s; animation-delay:-3s; }
  .mk-bg :global(#foreground .ff:nth-of-type(3n)) { animation-duration:7s; animation-delay:-5s; }
  @keyframes ff { 0%,100% { transform:translate(0,0); opacity:.4; } 30% { transform:translate(10px,-14px); opacity:1; } 60% { transform:translate(-8px,-24px); opacity:.6; } }
  @keyframes fl { 0%,100% { translate:0 0; } 50% { translate:0 -9px; } }

  /* --- Stage: screens and Mylo, in 1440 coordinates --- */
  .mk-stage { position:absolute; top:0; left:50%; width:1440px; height:900px; transform:translateX(-50%); transform-origin:0 0; }
  .phones { position:absolute; inset:0; }
  .ph { position:absolute; margin:0; border-radius:22px; overflow:hidden; border:2px solid rgba(255,255,255,.7); background:#0E0E14; box-shadow:0 20px 40px rgba(14,8,50,.45); transform:rotate(var(--r)); animation:fl 6s ease-in-out infinite; animation-delay:calc(var(--d) * -1); }
  .ph img { width:100%; height:100%; object-fit:cover; display:block; }

  .isl { position:absolute; left:1040px; top:318px; width:240px; height:122px; animation:fl 7s ease-in-out infinite; animation-delay:-2s; }
  .isl-art { position:absolute; inset:0; overflow:visible; }
  .mylo { position:absolute; left:0; top:13px; width:0; height:0; }
  .m-move { position:absolute; left:0; top:0; will-change:transform; }
  .m-flip { position:absolute; left:0; bottom:0; transform-origin:0 100%; }
  .m-body { position:relative; width:96px; height:150px; transform-origin:50% 100%; translate:-50% 14px; }
  .ly { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; }
  .ly.hat { z-index:4; } .ly.outfit { z-index:3; } .ly.face { z-index:2; } .ly.body { z-index:1; }
  .shadow { position:absolute; left:-30px; top:-4px; width:60px; height:10px; border-radius:50%; background:rgba(20,30,40,.28); }

  .spark { position:absolute; left:0; top:-110px; pointer-events:none; }
  .spark i { position:absolute; width:10px; height:10px; background:#FFD27A; clip-path:polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%); opacity:0; }
  .spark.go i { animation:spk 900ms cubic-bezier(.2,.8,.2,1) forwards; }
  @keyframes spk { 0% { opacity:1; transform:rotate(var(--a)) translateY(-8px) scale(.6); } 100% { opacity:0; transform:rotate(var(--a)) translateY(-64px) scale(1.2); } }

  .gem { position:absolute; left:0; top:0; width:16px; height:16px; border-radius:3px; background:linear-gradient(135deg, #F30058, #FFA41C 40%, #19F2FF 75%, #3084FF); opacity:0; pointer-events:none; }

  @media (prefers-reduced-motion:reduce){ .mk :global(*) { animation:none !important; } }
  :global(.frame:not(.on)) .mk :global(*) { animation-play-state:paused !important; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mk]').forEach(root => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const frame = root.closest<HTMLElement>('.frame');
    const move = root.querySelector<HTMLElement>('[data-move]')!;
    const flip = root.querySelector<HTMLElement>('[data-flip]')!;
    const body = root.querySelector<HTMLElement>('[data-body]')!;
    const spark = root.querySelector<HTMLElement>('[data-spark]')!;
    const gem = root.querySelector<HTMLElement>('[data-gem]')!;
    const L = (k: string) => root.querySelector<HTMLImageElement>(`[data-l="${k}"]`)!;
    const K = '/work/mylo/kit/';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const looks = [
      { hat: 'beanie', outfit: 'sweater', face: 'love' },
      { hat: 'headphones', outfit: 'jacket', face: 'cool' },
      { hat: 'party', outfit: 'tux', face: 'excited' },
    ];
    looks.forEach(l => Object.entries(l).forEach(([k, v]) => { new Image().src = `${K}${k}-${v}.webp`; }));

    // Fit: full size on desktop; on phones zoom into the screens and Mylo
    const bg = root.querySelector<HTMLElement>('.mk-bg')!;
    const fit = () => {
      const w = root.clientWidth;
      if (w >= 1024) {
        stage.style.left = '50%'; stage.style.top = '0'; stage.style.transform = 'translateX(-50%)';
        bg.removeAttribute('style'); return;
      }
      // Phones: background and stage share one zoom so the scene stays in proportion
      const k = w / 980, cx = 830, t = `translateX(${w / 2 - cx * k}px) scale(${k})`;
      stage.style.left = '0'; stage.style.top = '40px'; stage.style.transform = t;
      Object.assign(bg.style, { inset: 'auto', left: '0', top: '40px', width: '1440px', height: '900px', transformOrigin: '0 0', transform: t });
    };
    fit(); addEventListener('resize', fit);

    // Pointer parallax: SVG layers and the HTML stage move by their depth
    const svgLayers = [...root.querySelectorAll<SVGGElement>('svg.kd [data-depth]')];
    const htmlLayers = [...root.querySelectorAll<HTMLElement>('.mk-stage [data-depth]')];
    addEventListener('pointermove', e => {
      if (reduce || innerWidth < 1024) return;
      const nx = e.clientX / innerWidth - .5, ny = e.clientY / innerHeight - .5;
      svgLayers.forEach(l => { const d = Number(l.dataset.depth); l.style.transform = `translate(${nx * -d}px, ${ny * -d * .5}px)`; });
      htmlLayers.forEach(l => { const d = Number(l.dataset.depth); l.style.translate = `${nx * -d}px ${ny * -d * .5}px`; });
    }, { passive: true });

    let look = 0;
    const wear = (i: number, face?: string) => {
      const l = looks[i];
      L('hat').src = `${K}hat-${l.hat}.webp`; L('outfit').src = `${K}outfit-${l.outfit}.webp`; L('face').src = `${K}face-${face ?? l.face}.webp`;
    };
    const burst = () => { spark.classList.remove('go'); void spark.offsetWidth; spark.classList.add('go'); };
    const ISL = { x: 1040, y: 318 + 13 };
    if (reduce) { move.style.transform = 'translate(120px, 0)'; return; }

    // 14s loop. x is the feet position on the island art (0..240); grass spans about 20..220.
    const T = 14000, X0 = 60, X1 = 180;
    const ease = (t: number) => t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    const clamp = (t: number) => Math.max(0, Math.min(1, t));
    const drops = [6200, 11000, 13400];
    const xAt = (t: number) => {
      if (t < 1500) return X0;
      if (t < 4000) return X0 + (X1 - X0) * ease(clamp((t - 1500) / 2500));
      if (t < 8000) return X1;
      if (t < 10800) return X1 - (X1 - X0) * ease(clamp((t - 8000) / 2800));
      return X0;
    };
    const walking = (t: number) => (t > 1500 && t < 4000) || (t > 8000 && t < 10800);
    const facing = (t: number) => (t >= 7600 && t < 10800) ? -1 : 1;
    const hopAt = (t: number) => {
      const hops = [[4000, 520, 38], [10800, 520, 38], [6200, 360, 16], [11000, 360, 16], [13400, 360, 16]];
      for (const [s, dur, h] of hops) { const p = (t - s) / dur; if (p >= 0 && p <= 1) return { y: -Math.sin(p * Math.PI) * h, sq: p < .15 ? 1 - p * .8 : p > .85 ? 1 - (1 - p) * .8 : 1 }; }
      return { y: 0, sq: 1 };
    };
    const gemAt = (t: number) => {
      for (const d of drops) {
        const p = (t - (d - 700)) / 700;
        if (p >= 0 && p <= 1) {
          const from = { x: 570, y: 180 }, to = { x: ISL.x + xAt(d) - 8, y: ISL.y - 120 };
          const e = ease(p);
          const x = from.x + (to.x - from.x) * e, y = from.y + (to.y - from.y) * e - Math.sin(p * Math.PI) * 90;
          gem.style.opacity = p < .9 ? '1' : String((1 - p) * 10);
          gem.style.transform = `translate(${x}px, ${y}px) rotate(${p * 540}deg) scale(${1 - p * .4})`;
          return;
        }
      }
      gem.style.opacity = '0';
    };

    let fired = new Set<number>(), excited = false, lastT = 0, start = performance.now(), wasOn = true;
    const reset = (now: number) => { start = now; lastT = 0; fired.clear(); look = 0; wear(0); };
    const tick = (now: number) => {
      const on = !frame || frame.classList.contains('on');
      if (!on) { wasOn = false; requestAnimationFrame(tick); return; }
      if (!wasOn) { reset(now); wasOn = true; }
      const t = (now - start) % T;
      if (t < lastT) { fired.clear(); look = 0; wear(0); }
      lastT = t;
      const x = xAt(t), w = walking(t), hop = hopAt(t);
      const phase = t / 1000 * Math.PI * 4;
      const bob = w ? -Math.abs(Math.sin(phase)) * 5 : 0, rot = w ? Math.sin(phase) * 5 : 0;
      const breathe = 1 + Math.sin(t / 1000 * Math.PI * 1.2) * .018;
      move.style.transform = `translate(${x}px, ${bob + hop.y}px)`;
      flip.style.transform = `scaleX(${facing(t)})`;
      body.style.transform = `rotate(${rot}deg) scale(${2 - hop.sq}, ${breathe * hop.sq})`;
      if (t > 4400 && t < 6000 && !excited) { excited = true; L('face').src = `${K}face-excited.webp`; burst(); }
      if (t >= 6000 && excited) { excited = false; L('face').src = `${K}face-${looks[look].face}.webp`; }
      gemAt(t);
      drops.forEach((d, i) => { if (t >= d && !fired.has(d)) { fired.add(d); look = (i + 1) % looks.length; wear(look); burst(); } });
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    addEventListener('intro-done', () => reset(performance.now()), { once: true });
  });
</script>
