---
// Spotify-style hero slide: one tilted device with real screens playing inside it,
// and cards that slide out past its edges in time with what the screen shows.
// Stage is 1440 x 900 hero coordinates. Moving parts stay inside x 160-1280, top band y 80-380,
// plus the middle column (x 720-1020), so the headline and Now Playing stay clear.
import Icon from '../Icon.astro';

type Screen = { src: string; from: number; to: number; scroll?: number };
type Pop = { side: 'l' | 'r'; edge: number; y: number; at: [number, number]; icon?: string; html: string; kind?: 'chip' | 'card' | 'bubble' | 'cta' };
interface Props {
  name: string;
  bg: string; shape: string;
  device: 'phone' | 'browser';
  box: { cx: number; top: number; w: number; h: number; ry: number; rz: number };
  screens: Screen[];
  pops: Pop[];
  extra?: { src: string; cx: number; top: number; h: number; ry: number; rz: number; alt: string };
  T: number;
}
const { name, bg, shape, device, box, screens, pops, extra, T } = Astro.props;
---
<div class="ds" data-ds data-t={T} style={`--bg:${bg};--shape:${shape}`}>
  <svg class="ds-bg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
    <rect width="1440" height="900" fill={bg} />
    <circle cx="880" cy="250" r="300" fill={shape} />
    <circle cx="880" cy="250" r="190" fill={bg} opacity=".55" />
    <circle cx="300" cy="140" r="90" fill={shape} opacity=".6" />
    <circle cx="1220" cy="120" r="60" fill={shape} opacity=".6" />
  </svg>

  <div class="ds-stage" data-stage>
    <div class="dev-wrap" data-depth="10" style={`left:${box.cx - box.w / 2}px;top:${box.top}px;width:${box.w}px;height:${box.h}px`}>
      <div class:list={['dev', device]} style={`--ry:${box.ry}deg;--rz:${box.rz}deg`}>
        <div class="scr">
          {screens.map((s, i) => (
            <img class="sc" data-from={s.from} data-to={s.to} data-scroll={s.scroll ?? 0} src={s.src} alt={`${name} screen ${i + 1}`} loading="lazy" decoding="async" />
          ))}
        </div>
        {device === 'phone' && <span class="notch" aria-hidden="true"></span>}
      </div>
    </div>

    {extra && (
      <div class="extra-wrap" data-depth="22" style={`left:${extra.cx - extra.h * 0.24}px;top:${extra.top}px;height:${extra.h}px`}>
        <img class="extra" src={extra.src} alt={extra.alt} style={`--ry:${extra.ry}deg;--rz:${extra.rz}deg`} loading="lazy" />
      </div>
    )}

    <div class="pops" data-depth="28">
      {pops.map(p => (
        <div class:list={['pop', p.kind ?? 'chip', p.side, { mhide: (p.side === 'r' && p.edge > 1050) || (p.side === 'l' && p.edge < 600) }]} data-at={p.at.join(',')}
             style={p.side === 'l' ? `right:${1440 - p.edge}px;top:${p.y}px` : `left:${p.edge}px;top:${p.y}px`}>
          {p.icon && <span class="pi"><Icon name={p.icon} size={14} /></span>}
          <span class="pt" set:html={p.html}></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .ds { position:absolute; inset:0; overflow:hidden; background:var(--bg); }
  .ds-bg { position:absolute; inset:0; width:100%; height:100%; }
  .ds-bg circle:first-of-type { animation:breathe 9s ease-in-out infinite; transform-origin:880px 250px; }
  @keyframes breathe { 50% { transform:scale(1.06); } }

  .ds-stage { position:absolute; top:0; left:50%; width:1440px; height:900px; transform:translateX(-50%); transform-origin:0 0; perspective:1400px; }
  .dev-wrap, .extra-wrap { position:absolute; transform-style:preserve-3d; }
  .dev { position:relative; width:100%; height:100%; transform:rotateY(var(--ry)) rotateX(5deg) rotateZ(var(--rz)); animation:sway 8s ease-in-out infinite; transform-style:preserve-3d; }
  @keyframes sway { 0%,100% { transform:rotateY(var(--ry)) rotateX(5deg) rotateZ(var(--rz)) translateY(0); } 50% { transform:rotateY(calc(var(--ry) * .6)) rotateX(3deg) rotateZ(var(--rz)) translateY(-8px); } }
  .dev.phone { border-radius:34px; padding:8px; background:#0B0B0F; box-shadow:0 0 0 2px rgba(255,255,255,.14), 0 40px 80px rgba(0,0,0,.45); }
  .dev.browser { border-radius:14px; box-shadow:0 0 0 1px rgba(255,255,255,.12), 0 40px 80px rgba(0,0,0,.45); }
  .scr { position:relative; width:100%; height:100%; overflow:hidden; border-radius:inherit; background:#fff; }
  .dev.phone .scr { border-radius:26px; }
  .sc { position:absolute; left:0; top:0; width:100%; height:auto; opacity:0; transition:opacity 500ms ease; will-change:transform; }
  .dev.browser .sc { height:100%; object-fit:cover; object-position:0 0; }
  .sc.on { opacity:1; }
  .notch { position:absolute; left:50%; top:14px; width:64px; height:18px; translate:-50% 0; border-radius:12px; background:#0B0B0F; }

  .extra { height:100%; width:auto; border-radius:28px; box-shadow:0 30px 60px rgba(0,0,0,.4); transform:rotateY(var(--ry)) rotateZ(var(--rz)); animation:fl 6s ease-in-out infinite; animation-delay:-2s; display:block; }
  @keyframes fl { 0%,100% { translate:0 0; } 50% { translate:0 -10px; } }

  .pops { position:absolute; inset:0; pointer-events:none; }
  .pop { position:absolute; display:flex; align-items:center; gap:8px; padding:10px 14px; border-radius:14px; background:#fff; color:#121212; font:500 13px/18px var(--f-sans, Inter, sans-serif); box-shadow:0 14px 30px rgba(0,0,0,.28); opacity:0; white-space:nowrap; transition:opacity 420ms ease, transform 620ms cubic-bezier(.2,.9,.25,1.15); }
  .pop.l { transform:translateX(60px) scale(.85); transform-origin:right center; }
  .pop.r { transform:translateX(-60px) scale(.85); transform-origin:left center; }
  .pop.on { opacity:1; transform:none; }
  .pop .pi { display:grid; place-items:center; width:26px; height:26px; border-radius:8px; background:var(--shape); color:#fff; flex:none; }
  .pop.card { flex-direction:column; align-items:flex-start; gap:6px; padding:12px; width:190px; white-space:normal; }
  .pop.card .pt { display:flex; flex-direction:column; align-items:flex-start; gap:6px; width:100%; }
  .pop.bubble { white-space:normal; width:260px; align-items:flex-start; border-bottom-left-radius:4px; }
  .pop.cta { background:#E09A2D; color:#1A1205; font-weight:600; border-radius:999px; padding:12px 20px; }
  .pop :global(.k) { font-size:11px; color:#6B6B6B; text-transform:uppercase; letter-spacing:.06em; }
  .pop :global(.b) { font-weight:600; }
  .pop :global(.tag) { display:inline-block; padding:3px 8px; border-radius:999px; background:#D9F99D; color:#1A2E05; font-size:10px; font-weight:600; letter-spacing:.04em; }
  .pop :global(.pimg) { width:100%; height:120px; object-fit:contain; background:#F4F4F2; border-radius:10px; }
  .pop :global(.row) { display:flex; justify-content:space-between; width:100%; align-items:center; }
  .pop :global(.chips) { display:flex; gap:6px; flex-wrap:wrap; }
  .pop :global(.chips span) { padding:5px 10px; border:1px solid #D4D4D4; border-radius:999px; font-size:12px; }

  /* Phones: cards that would fall off the screen edge stay hidden */
  @media (max-width:1023px){ .pop.mhide { display:none; } }
  @media (prefers-reduced-motion:reduce){ .ds :global(*) { animation:none !important; transition:none !important; } }
  :global(.frame:not(.on)) .ds :global(*) { animation-play-state:paused !important; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ds]').forEach(root => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const frame = root.closest<HTMLElement>('.frame');
    const T = Number(root.dataset.t);
    const scs = [...root.querySelectorAll<HTMLImageElement>('.sc')];
    const pops = [...root.querySelectorAll<HTMLElement>('.pop')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const fit = () => {
      const w = root.clientWidth;
      if (w >= 1024) { stage.style.left = '50%'; stage.style.top = '0'; stage.style.transform = 'translateX(-50%)'; return; }
      const k = w / 780, cx = 880;
      stage.style.left = '0'; stage.style.top = '40px';
      stage.style.transform = `translateX(${w / 2 - cx * k}px) scale(${k})`;
    };
    fit(); addEventListener('resize', fit);

    const layers = [...root.querySelectorAll<HTMLElement>('[data-depth]')];
    addEventListener('pointermove', e => {
      if (reduce || innerWidth < 1024) return;
      const nx = e.clientX / innerWidth - .5, ny = e.clientY / innerHeight - .5;
      layers.forEach(l => { const d = Number(l.dataset.depth); l.style.translate = `${nx * -d}px ${ny * -d * .5}px`; });
    }, { passive: true });

    if (reduce) { scs[0]?.classList.add('on'); return; }
    let start = performance.now(), wasOn = false;
    const tick = (now: number) => {
      const on = !frame || frame.classList.contains('on');
      if (!on) { wasOn = false; requestAnimationFrame(tick); return; }
      if (!wasOn) { start = now; wasOn = true; }
      const t = (now - start) % T;
      scs.forEach(s => {
        const a = Number(s.dataset.from), b = Number(s.dataset.to), sc = Number(s.dataset.scroll);
        const live = t >= a && t < b; s.classList.toggle('on', live);
        if (live && sc) { const p = (t - a) / (b - a); const e = p < .15 ? 0 : Math.min(1, (p - .15) / .75); s.style.transform = `translateY(${-sc * (e * e * (3 - 2 * e))}px)`; }
        if (!live) s.style.transform = '';
      });
      pops.forEach(p => { const [a, b] = p.dataset.at!.split(',').map(Number); p.classList.toggle('on', t >= a && t < b); });
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
