  import { play } from '../lib/sensory';
  import { Rive, Layout, Fit, Alignment, RuntimeLoader } from '@rive-app/canvas';
  RuntimeLoader.setWasmUrl('/rive/rive.wasm');

  // Scale Figma-size diagrams to the available width.
  const fit = () => document.querySelectorAll<HTMLElement>('.dg').forEach(d => {
    // Scale to fit, but never below a readable size. On phones, the rest scrolls sideways.
    const w = Number(d.dataset.w), avail = d.clientWidth, min = d.classList.contains('panel') ? 0.78 : 0.62;
    const k = Math.min(1, Math.max(min, avail / w));
    d.style.setProperty('--k', String(k));
    d.classList.toggle('swipe', k * w > avail + 2);
  });
  fit(); addEventListener('resize', fit);

  // Hero reel: left timer line + right segments drive frames and Now Playing.
  const frames = [...document.querySelectorAll<HTMLElement>('.reel .frame')];
  const items = [...document.querySelectorAll<HTMLElement>('.np-item')];
  const segs = [...document.querySelectorAll<HTMLElement>('.seg span')];
  const DUR = 7000, reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Rive hero scenes: one player per frame, only the frame on screen plays.
  const rives = new Map<HTMLElement, Rive>();
  frames.forEach(f => {
    const c = f.querySelector<HTMLCanvasElement>('canvas[data-rive]'); if (!c) return;
    const r = new Rive({ src: c.dataset.rive!, canvas: c, autoplay: false, stateMachines: 'State Machine 1',
      layout: new Layout({ fit: Fit.Contain, alignment: Alignment.TopCenter }),
      onLoad: () => { r.resizeDrawingSurfaceToCanvas(); if (f.classList.contains('on') && !reduce) r.play(); } });
    rives.set(f, r);
  });
  addEventListener('resize', () => rives.forEach(r => r.resizeDrawingSurfaceToCanvas()));
  let i = 0, t0 = performance.now();
  const show = (n: number) => {
    i = (n + items.length) % items.length; t0 = performance.now();
    frames.forEach((f, k) => {
      f.classList.toggle('on', k === i);
      const v = f.querySelector('video'); if (v) k === i ? v.play().catch(() => {}) : v.pause();
      const r = rives.get(f); if (r && !reduce) k === i ? r.play() : r.pause();
    });
    items.forEach((f, k) => f.classList.toggle('on', k === i));
    segs.forEach((s, k) => s.style.setProperty('--p', k < i ? '1' : '0'));
  };
  const tick = (now: number) => {
    if (!document.hidden && !reduce) {
      const p = Math.min(1, (now - t0) / DUR);
      segs[i]?.style.setProperty('--p', String(p));
      if (p >= 1) show(i + 1);
    }
    requestAnimationFrame(tick);
  };
    document.querySelectorAll<HTMLElement>('[data-go]').forEach(b => b.addEventListener('click', () => { show(Number(b.dataset.go)); play('tick'); }));
  show(0); requestAnimationFrame(tick);

  // Copy buttons
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach(b => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); } catch {}
    const old = b.innerHTML; b.textContent = 'Copied'; play('success'); setTimeout(() => (b.innerHTML = old), 1400);
  }));

  // How I work: the step in the middle of the screen lights up in the list.
  const links = new Map([...document.querySelectorAll<HTMLElement>('[data-step]')].map(a => [a.dataset.step!, a]));
  const stepsEls = [...document.querySelectorAll<HTMLElement>('.step')];
  const ind = document.querySelector<HTMLElement>('.ind');
  let cur = '';
  const pickStep = () => {
    let id = stepsEls[0]?.id ?? '';
    for (const st of stepsEls) if (st.getBoundingClientRect().top < innerHeight * 0.5) id = st.id;
    if (id === cur) return; cur = id;
    links.forEach(a => a.classList.remove('on'));
    const a = links.get(id.replace('step-', ''));
    if (a) { a.classList.add('on'); ind?.style.setProperty('--iy', `${a.offsetTop + a.offsetHeight - 1}px`); }
  };
  addEventListener('scroll', pickStep, { passive: true }); pickStep();
</script>
