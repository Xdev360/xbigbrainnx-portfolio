---
// Home. Every number here comes from Figma frame "Home – Dark" (1440 wide).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import CoverPh from '../components/CoverPh.astro';
import WinPh from '../components/WinPh.astro';
import { projects, heroReel, caseHref } from '../data/projects';

const steps = [
  { n:'01', t:'Start with the brief', d:'A first call with the founder and the people who use it. I write the real problem in one line before any screen.',
    note:'Customers can’t tell real products from fakes, delivery dates are a guess, and nobody replies at night. Build one store they can trust, and one place for three staff to run it.' },
  { n:'02', t:'Design it in Figma', d:'Flows first, then every screen and state, light and dark. Customer side and team side in the same file.',
    wins:[{ title:'Figma · Virelle', path:'store + crm', note:'Custom visual: the Figma file', x:0, y:0, w:420, h:300 }, { title:'Review link', path:'shared with the team', note:'Custom visual: the review page', x:302, y:140, w:320, h:240 }] },
  { n:'03', t:'Get notes from the team', d:'The team reviews from a link and sends notes in the group chat. Each round becomes a short list of changes.',
    cover:'Visual · a review round', note:'Show the courier wallet balance to everyone, keep Lagos and Abuja as separate delivery queues, and let staff add walk-in orders by hand.' },
  { n:'04', t:'Build it in code', d:'Same colors, type and spacing as the Figma file. I check every screen on real phones before it ships.',
    wins:[{ title:'ProductCard.astro', path:'~/virelle', note:'Custom visual: the code', x:0, y:0, w:380, h:300 }, { title:'Preview', path:'localhost:4321', note:'Custom visual: the live preview', x:282, y:120, w:340, h:260 }] },
  { n:'05', t:'Ship it, then measure', d:'Launch, then watch what changed: return rate for customers, time per task for the team.', cover:'Visual · launch and numbers' },
];
const duo = ['virelle-store', 'virelle-crm'].map(sl => projects.find(p => p.slug === sl)!);
const grid = ['mylo', 'goalden', 'chatgrow'].map(sl => projects.find(p => p.slug === sl)!);
const codeLines = [':root {','  --bg-page: #FFFFFF;','  --text-primary: #000000;','  --border-default: #EBEBEB;','  --radius-button: 4px;','}','','[data-theme="dark"] {','  --bg-page: #000000;','  --text-primary: #FFFFFF;','  --border-default: #1A1A1A;','}'];
const surfIcons = [['Web','globe'],['iOS and Android','smartphone'],['Admin and CRM','layout-dashboard'],['Email','mail'],['Brand identity','layers'],['Packaging','package'],['Social and ads','image'],['Motion','video']];
const compare = [
  ['Customers should come back, not just visit once', true],
  ['A team runs orders, stock or bookings behind it', true],
  ['It needs an app, a store and a back office that match', true],
  ['You want motion, sound and touch that feel considered', true],
  ['You need the brand, packaging and launch posts too', true],
  ['It’s a simple site for a small business, live this week', false],
] as const;
const testimonials: { quote:string; name:string; role:string }[] = []; // real quotes only
const pos = (x:number,y:number,w?:number,h?:number) => `left:${x}px;top:${y}px;${w?`width:${w}px;`:''}${h?`height:${h}px;`:''}`;
// Surfaces diagram lines (spectrum), exported from Figma
const lines = [
  { x:702, y:209, w:379, h:2,   d:'M378.5 1C189.25 1 189.25 1 0 1' },
  { x:702, y:209, w:159, h:112, d:'M158.5 111C79.25 111 79.25 1 0 1' },
  { x:702, y:89,  w:129, h:122, d:'M128.5 1C64.25 1 64.25 121 0 121' },
  { x:330, y:209, w:169, h:127, d:'M0 126C84.25 126 84.25 1 168.5 1' },
  { x:370, y:84,  w:129, h:127, d:'M0 1C64.25 1 64.25 126 128.5 126' },
  { x:114, y:209, w:385, h:2,   d:'M0 1C192.25 1 192.25 1 384.5 1' },
];
const devices = [
  { n:'Mobile app',   x:40,  y:140, w:74,  h:140, r:14, bars:[[11,42,41],[11,54,31],[11,66,21]], lx:39,  ly:290 },
  { n:'Store · web',  x:200, y:30,  w:170, h:110, r:8,  bars:[[26,33,94],[26,45,84],[26,57,74]], lx:243, ly:150 },
  { n:'Social posts', x:220, y:280, w:110, h:110, r:6,  bars:[[17,33,61],[17,45,51],[17,57,41]], lx:229, ly:400 },
  { n:'Team CRM',     x:830, y:20,  w:220, h:140, r:8,  bars:[[33,42,121],[33,54,111],[33,66,101]], lx:910, ly:170 },
  { n:'Packaging',    x:860, y:270, w:120, h:100, r:4,  bars:[[18,30,66],[18,42,56],[18,54,46]], lx:886, ly:380 },
  { n:'Email',        x:1080,y:170, w:110, h:80,  r:6,  bars:[[17,24,61],[17,36,51],[17,48,41]], lx:1116,ly:260 },
];
---
<Base>
  <!-- ============ HERO (1440x900 incl. nav) ============ -->
  <section class="hero" data-reel>
    <div class="reel" aria-hidden="true">
      {heroReel.map((p, i) => (
        <div class:list={['frame', { on: i === 0 }]}>
          {p.scene && <img class="scene" src={p.scene} alt="" loading={i === 0 ? 'eager' : 'lazy'} />}
          {p.reel && <video src={p.reel} poster={p.scene} muted loop playsinline preload="none" />}
          {p.rive && <canvas class="rive-scene" data-rive={p.rive} width="2880" height="1800" aria-hidden="true"></canvas>}
          {!p.scene && !p.reel && !p.rive && <span class="mono-tag c-subtle reel-label">Hero scene · 2880 × 1800 · /work/{p.slug}/hero.webp</span>}
        </div>
      ))}
      <div class="fade"></div>
    </div>

    <div class="hero-in">
      <div class="copy">
        <div class="hline"></div>
        <span class="eyebrow c-muted" style="margin-top:28px;--d:100ms" data-reveal>Product design, built in code</span>
        <h1 class="display-xl c-primary" style="margin-top:20px" data-split>Products people<br />come back to</h1>
        <p class="body c-secondary" style="margin-top:20px;--d:350ms" data-reveal>I design the app customers use and the tools the team runs it on.<br />Then I build both in code, motion and sound included.</p>
        <a href="/work" class="btn btn-solid" style="margin-top:32px;align-self:flex-start;--d:450ms" data-sfx="click" data-reveal data-magnetic>See my work <Icon name="arrow-right" size={14} /></a>
        <p class="small" style="margin-top:20px;--d:520ms" data-reveal><span class="c-muted">Hiring?</span> <button class="copy-link small c-secondary u" data-copy="xbigbrainnx@gmail.com">Copy my email</button></p>
        <hr class="rule grow" style="margin-top:40px;--d:600ms" data-reveal="fade" />
        <span class="eyebrow c-subtle" style="margin-top:20px;--d:650ms" data-reveal>Designed and built with</span>
        <div class="logos" style="margin-top:14px" data-stagger="50">
          {(['Figma','Claude','Rive','Lottie','Astro','Supabase','Vercel'] as const).map((n, i) => <span data-reveal="scale" style={`--d:${700 + i * 50}ms`} class="lg"><Logo name={n} size={20} /></span>)}
        </div>
      </div>

      <aside class="np" aria-live="polite" data-reveal="fade" style="--d:500ms">
        <div class="segs" role="tablist" aria-label="Projects">{heroReel.map((p, i) => <button class="seg" role="tab" data-go={i} aria-label={p.name}><span></span></button>)}</div>
        <div class="np-items">
          {heroReel.map((p, i) => (
            <div class:list={['np-item', { on: i === 0 }]}>
              <div class="counter"><span class="eyebrow c-primary">{String(i + 1).padStart(2,'0')} / {String(heroReel.length).padStart(2,'0')}</span><span class="eyebrow c-muted">Now playing</span></div>
              <h2 class="np-title"><span>{p.name}</span></h2>
              <p class="small c-muted" style="margin-top:12px">{p.short}</p>
              <div class="np-row" style="margin-top:16px"><span class="eyebrow c-subtle">Role</span><span class="small c-secondary">{p.role}</span></div>
              <div class="np-row"><span class="eyebrow c-subtle">Use case</span><span class="small c-secondary u">{p.useCase}</span></div>
              <a href={caseHref(p)} class="btn btn-s btn-outline" style="margin-top:20px;align-self:flex-start" data-sfx="click">Read the story</a>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ HOW I WORK ============ -->
  <section class="sec bg-alt" id="how-i-work">
    <div class="sec-in hiw">
      <div class="sticky">
        <span class="eyebrow c-muted" data-reveal>How I work</span>
        <h2 class="h2s c-heading" style="margin-top:16px" data-split>Talk to the people.<br />Then build it by hand.</h2>
        <p class="body c-secondary" style="margin-top:20px;max-width:412px">I start with the people who use the product, design it in Figma, and build it in code. The team reviews every round from a link, no Figma account needed.</p>
        <p class="small c-subtle" style="margin-top:12px;max-width:412px">Client projects and my own products. Based in Lagos, working remote worldwide.</p>
        <div class="btns" style="margin-top:28px">
          <button class="btn btn-s btn-solid" data-copy="xbigbrainnx@gmail.com">Copy my email</button>
          <a href="/work/virelle-store" class="btn btn-s btn-outline">See a case study</a>
        </div>
        <ol class="steplist" style="margin-top:40px"><span class="ind" aria-hidden="true"></span>
          {steps.map((s, i) => <li><a href={`#step-${s.n}`} data-step={s.n} class:list={{ on: i === 0 }}><span class="eyebrow num">{s.n}</span><span class="nm">{s.t}</span></a></li>)}
        </ol>
      </div>

      <div class="steps">
        {steps.map(s => (
          <article class="step" id={`step-${s.n}`} data-stagger="80">
            <span class="eyebrow c-subtle" data-reveal>{s.n}</span>
            <h3 class="h3 c-heading" style="margin-top:12px" data-reveal>{s.t}</h3>
            <p class="lede c-muted" style="margin-top:12px;max-width:600px" data-reveal>{s.d}</p>
            {s.wins && (
              <div class="wins" style="margin-top:24px" data-reveal>
                {s.wins.map((w, k) => <div class="wwrap" style={`position:absolute;${pos(w.x,w.y,w.w,w.h)}`} data-parallax={k ? "0.06" : "0"}><WinPh title={w.title} path={w.path} note={w.note} style="width:100%;height:100%" /></div>)}
              </div>
            )}
            {s.cover && <div data-reveal style="margin-top:24px"><CoverPh label={s.cover} h={320} /></div>}
            {s.note && (
              <div class="notebox spectrum" style="margin-top:24px" data-reveal="blur">
                <p class="nb-text">{s.note}</p>
                <button class="btn btn-s btn-outline nb-copy" data-copy={s.note} style="gap:6px"><Icon name="copy" size={12} />Copy</button>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SELECTED WORK ============ -->
  <section class="sec">
    <div class="sec-in">
      <div class="shead">
        <div class="shead-l"><span class="eyebrow c-muted" data-reveal>Selected work</span><h2 class="h2 c-heading" data-split>Products I designed<br />and built</h2></div>
        <div class="shead-r" data-reveal style="--d:150ms">
          <p class="lede c-secondary">Each one has a side customers use and a side the team runs it on. Some are for clients, some are my own products. Open any of them for the full story.</p>
          <div class="btns"><a href="/work" class="btn btn-s btn-outline">All case studies</a><a href="/cv" class="btn btn-s btn-outline">Get my CV</a><a href="/writing" class="btn btn-s btn-outline">Writing</a></div>
        </div>
      </div>
      <div class="duo-h" style="margin-top:56px" data-reveal>
        <span class="eyebrow c-subtle">Virelle Wellness Hub</span>
        <span class="duo-rule" aria-hidden="true"></span>
        <span class="eyebrow c-muted">Two sides of one business</span>
      </div>
      <div class="duo" data-stagger="120">
        {duo.map((p, i) => (
          <a href={caseHref(p)} class="work" data-sfx="click" data-reveal data-spot>
            <CoverPh label={`Cover · ${p.name}`} h={520} src={p.cover} class="big" />
            <div class="cap"><span class="label c-accent">{i === 0 ? 'What customers see' : 'What the team runs on'}</span><span class="eyebrow c-primary ttl">{p.name}<Icon name="arrow-up-right" size={14} class="go" /></span><span class="caption c-muted" style="max-width:420px">{p.short}</span></div>
          </a>
        ))}
      </div>
      <div class="wgrid" style="margin-top:56px" data-stagger="110">
        {grid.map(p => (
          <a href={caseHref(p)} class="work" data-sfx="click" data-reveal data-spot>
            <CoverPh label={`Cover · ${p.name}`} h={280} src={p.cover} />
            <div class="cap"><span class="eyebrow c-primary ttl">{p.name}<Icon name="arrow-up-right" size={14} class="go" /></span><span class="caption c-muted">{p.short}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BUILT IN CODE ============ -->
  <section class="sec bt">
    <div class="sec-in">
      <div class="shead">
        <div class="shead-l" style="gap:20px;max-width:520px">
          <span class="eyebrow c-muted" data-reveal>Design engineering</span>
          <h2 class="h2 c-heading" data-split>I build what<br />I design</h2>
          <p class="lede c-secondary" style="max-width:480px">The colors, type and spacing in my Figma file are the same values in the code. What you approve is what goes live.</p>
          <div class="btns"><a href="/work/virelle-store" class="btn btn-s btn-outline">See the code</a><a href="#how-i-work" class="btn btn-s btn-outline">How I work</a></div>
        </div>
        <div class="shead-r points" data-stagger="90">
          <div class="pt" data-reveal><span class="eyebrow c-primary">One source of truth</span><span class="body c-secondary">Light and dark, named once in Figma and used by the code.</span></div>
          <div class="pt" data-reveal><span class="eyebrow c-primary">Components, not copies</span><span class="body c-secondary">Every button and card is built once and used everywhere.</span></div>
          <div class="pt" data-reveal><span class="eyebrow c-primary">Checked on real phones</span><span class="body c-secondary">Every screen is tested on the devices people actually use.</span></div>
        </div>
      </div>
      <div class="dg" data-w="1200" data-h="440" style="margin-top:56px">
        <div class="dg-in" style="width:1200px;height:440px">
          <div class="codewin" style={pos(170,0,520,317)} data-reveal>
            <div class="cbar"><span class="small c-secondary">tokens.css</span><span class="mono-tag c-subtle">~/portfolio</span></div>
            <div class="code"><pre class="mono c-subtle">{codeLines.map((_, i) => i + 1).join('\n')}</pre><pre class="mono c-secondary" data-type>{codeLines.join('\n')}</pre></div>
          </div>
          <div style={`position:absolute;${pos(600,110,460,300)}--d:250ms`} data-reveal><div data-parallax="0.05" style="width:100%;height:100%"><WinPh title="Live preview" path="localhost:4321" note="Custom visual: the page updating" style="width:100%;height:100%" /></div></div>
          <div class="watch" style={pos(862,370) + "--d:600ms"} data-reveal="scale"><span class="dot"></span><span class="mono-tag c-muted">Watching for changes</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FIGMA TO LIVE ============ -->
  <section class="sec bt">
    <div class="sec-in">
      <div class="shead">
        <div class="shead-l" style="gap:20px;max-width:520px">
          <span class="eyebrow c-muted" data-reveal>Figma to production</span>
          <h2 class="h2 c-heading" data-split>From a Figma file<br />to a live product</h2>
          <p class="lede c-secondary" style="max-width:480px">Bring me your screens, or let me design them. I turn them into a working product with real data, motion and both themes.</p>
          <div class="btns"><a href="/work/virelle-store" class="btn btn-s btn-outline">See Virelle</a><a href="/contact" class="btn btn-s btn-outline">Book a call</a></div>
        </div>
        <div class="shead-r points" data-stagger="90">
          <div class="pt" data-reveal><span class="eyebrow c-primary">Every state, designed</span><span class="body c-secondary">Empty, loading, error and success, in light and dark.</span></div>
          <div class="pt" data-reveal><span class="eyebrow c-primary">Real components</span><span class="body c-secondary">The same parts in Figma and in the code.</span></div>
          <div class="pt" data-reveal><span class="eyebrow c-primary">One source of truth</span><span class="body c-secondary">Change it once, and the product changes everywhere.</span></div>
        </div>
      </div>
      <div class="dg" data-w="1200" data-h="420" style="margin-top:56px">
        <div class="dg-in" style="width:1200px;height:420px">
          <span class="eyebrow c-subtle abs" style={pos(0,0)}>Before</span><span class="title c-heading abs" style={pos(62,-2)}>Screens in Figma</span>
          <div class="box" style={pos(0,28,420,370)} data-reveal="left">
            <span class="mono-tag c-subtle abs" style={pos(16,24)}>Store · Product · Bag</span>
            {[16,148,280].map(x => (
              <div class="scr" style={pos(x,60,116,250)}>
                {[[24,84],[46,60],[68,84],[90,60],[112,84]].map(([y,w]) => <span class="bar6" style={pos(14,y,w,6)}></span>)}
                <span class="cta" style={pos(14,210,88,22)}></span>
              </div>
            ))}
          </div>
          <span class="arrow grow" style={pos(430,224,50,2) + "--d:400ms"} data-reveal="fade"></span>
          <div class="me" style={pos(490,150,220,190) + "--d:550ms"} data-reveal="scale">
            <span class="mono-tag c-subtle">Design + build</span>
            <span class="title c-heading">Turn this file into<br />the live store</span>
            {['Components','Data binding','Light and dark','Motion and sound'].map(t => <span class="mono-tag c-muted">·  {t}</span>)}
          </div>
          <span class="arrow grow" style={pos(720,224,50,2) + "--d:750ms"} data-reveal="fade"></span>
          <span class="eyebrow c-subtle abs" style={pos(780,0)}>After</span><span class="title c-heading abs" style={pos(833,-2)}>The product that ships</span>
          <div class="box after" style={pos(780,28,420,370) + "--d:900ms"} data-reveal>
            <span class="mono-tag c-muted abs" style={pos(16,170)}>Live components</span>
            <div class="phone" style={pos(135,40,150,300)}>
              <span class="pb" style={pos(20,30,110,60)}></span>
              {[110,150,190].map(y => <span class="pr" style={pos(20,y,110,28)}></span>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EVERY SURFACE ============ -->
  <section class="sec bt">
    <div class="sec-in">
      <div class="shead">
        <div class="shead-l"><span class="eyebrow c-muted" data-reveal>One product, every surface</span><h2 class="h2 c-heading" data-split>What I design<br />is what ships</h2></div>
        <div class="shead-r" data-reveal style="--d:150ms">
          <p class="lede c-secondary">The store, the app, the team’s CRM, the box it ships in and the posts that sell it. One system across all of them, so nothing drifts.</p>
          <div class="btns"><a href="/work/virelle-store" class="btn btn-s btn-outline">See Virelle</a><a href="/work?f=brand" class="btn btn-s btn-outline">Brand work</a></div>
        </div>
      </div>
      <div class="dg" data-w="1200" data-h="420" style="margin-top:56px">
        <div class="dg-in" style="width:1200px;height:420px">
          <svg class="abs" width="1200" height="420" viewBox="0 0 1200 420" fill="none" aria-hidden="true" style="left:0;top:0">
            <defs><linearGradient id="spec" x1="0" x2="1" y1="0" y2="0"><stop stop-color="#F30058"/><stop offset=".25" stop-color="#FF483C"/><stop offset=".45" stop-color="#FFA41C"/><stop offset=".6" stop-color="#71FF19"/><stop offset=".8" stop-color="#19F2FF"/><stop offset="1" stop-color="#3084FF"/></linearGradient></defs>
            {lines.map((l, i) => <g transform={`translate(${l.x} ${l.y})`}><path d={l.d} pathLength="1" stroke="url(#spec)" stroke-width="1.5" data-draw style={`--d:${300 + i * 120}ms`} /></g>)}
          </svg>
          {devices.map(d => (
            <>
              <div class="dev" style={pos(d.x,d.y,d.w,d.h) + `border-radius:${d.r}px;--d:${devices.indexOf(d) * 90}ms`} data-reveal="scale" data-hover-sfx>{d.bars.map(([x,y,w]) => <span class="bar5" style={pos(x,y,w,5)}></span>)}</div>
              <span class="mono-tag c-subtle abs" style={pos(d.lx,d.ly)}>{d.n}</span>
            </>
          ))}
          <div class="core" style={pos(499,176,203,68)} data-reveal="scale"><span class="mono-tag c-primary">One system</span><span class="mono-tag c-subtle">colors · type · motion</span></div>
        </div>
      </div>
      <div class="caps3" style="margin-top:56px" data-stagger="100">
        {[['One brand','The app, the box and the posts look like one company.'],['One system','Colors, type and parts are shared across every surface.'],['No drift','Change it once, and every surface gets the change.']].map(([t,d]) => (
          <div class="c3" data-reveal><span class="eyebrow c-primary">{t}</span><span class="caption c-muted" style="max-width:340px">{d}</span></div>
        ))}
      </div>
      <div style="margin-top:56px">
        <span class="eyebrow c-muted">Surfaces I design</span>
        <div class="surf" style="margin-top:16px" data-stagger="50">
          {surfIcons.map(([t, ic]) => <div class="sf" data-reveal data-hover-sfx><span class="c-primary"><Icon name={ic} size={16} /></span><span class="eyebrow c-secondary">{t}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ME OR A TEMPLATE ============ -->
  <section class="sec bg-alt">
    <div class="sec-in">
      <div class="shead">
        <div class="shead-l"><span class="eyebrow c-muted" data-reveal>Me or a template?</span><h2 class="h2 c-heading" data-split>Use the right<br />tool for the job</h2></div>
        <div class="shead-r" data-reveal style="--d:150ms">
          <p class="lede c-secondary">A custom product pays off when people use it every day and a team runs it. For a simple one-page site, a Wintech Template is the honest call.</p>
          <div class="btns"><a href="https://wintechstudio.com" class="btn btn-s btn-outline">Wintech Templates</a></div>
        </div>
      </div>
      <table class="cmp" style="margin-top:56px">
        <thead><tr><th class="eyebrow c-subtle">Bring me in when</th><th class="eyebrow c-subtle">Me</th><th class="eyebrow c-subtle">Template</th></tr></thead>
        <tbody data-stagger="70">
