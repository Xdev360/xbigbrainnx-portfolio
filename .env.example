# Copy to .env and fill in your Supabase values.
# Same names go in Vercel → Project Settings → Environment Variables.

# Supabase Dashboard → Project Settings → API → Project URL
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API → anon public
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Must match the key in supabase/schema.sql (admin saves)
SUPABASE_ADMIN_WRITE_KEY=your-admin-write-key

# Storage bucket name (default is fine if you ran schema.sql)
PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-media
